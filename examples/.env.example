# Telebirr credentials for examples/checkout.php
# Copy this file to .env and fill in your values:  cp .env.example .env
# examples/.env is gitignored — never commit real credentials.

# Environment: test (default) or production
TELEBIRR_ENVIRONMENT=test

# Credentials from Telebirr
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=

# RSA private key. Accepts a .pem file path, an inline PEM, or a raw base64 key body.
TELEBIRR_PRIVATE_KEY_PATH=
# TELEBIRR_PRIVATE_KEY=

# Telebirr public key (OPTIONAL). Only needed to VERIFY signatures on return URLs
# and notifications — NOT required to create a checkout. Same accepted forms as the
# private key. If left blank and Telebirr signs with your key pair, the library
# derives the public key from your private key automatically.
TELEBIRR_PUBLIC_KEY_PATH=
# TELEBIRR_PUBLIC_KEY=

# Server-to-server notification URL (required)
TELEBIRR_NOTIFY_URL=

# User return URL after payment (optional)
TELEBIRR_REDIRECT_URL=
